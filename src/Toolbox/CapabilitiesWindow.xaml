<Window x:Class="Toolbox.CapabilitiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Khả năng của tool" Width="760" Height="560" MinWidth="620" MinHeight="420"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <!-- Chân: thêm tay một hậu tố (lệnh con hoặc cờ) của tool, và đóng. Luôn hiện, không bị cuộn khuất. -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Đóng" IsCancel="True" IsDefault="True" MinWidth="90" Margin="12,0,0,0"
                        Style="{StaticResource PrimaryButton}" Click="OnClose" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" x:Name="AddLabel" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="1" Grid.Column="0" x:Name="NameBox" ToolTip="Ví dụ serve, --port hoặc -p" FontFamily="Consolas" Margin="0,4,0,0" />
                    <CheckBox Grid.Row="1" Grid.Column="1" x:Name="TakesBox" Content="Có giá trị" Margin="12,4,12,0" VerticalAlignment="Center"
                              ToolTip="Cờ có đi kèm giá trị không (--port 4200). Lệnh con không có giá trị." />
                    <TextBox Grid.Row="1" Grid.Column="2" x:Name="DescBox" Margin="0,4,12,0" ToolTip="Mô tả ngắn, không bắt buộc" />
                    <Button Grid.Row="1" Grid.Column="3" Content="Thêm" MinWidth="80" Margin="0,4,0,0" Click="OnAdd" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- Đầu: chọn lệnh, quét lại, trạng thái. -->
        <StackPanel DockPanel.Dock="Top" Margin="20,16,20,12">
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" />
            <DockPanel Margin="0,12,0,0">
                <Button DockPanel.Dock="Right" x:Name="RescanButton" Content="Quét lại" MinWidth="100" Margin="12,0,0,0"
                        Style="{StaticResource PrimaryButton}" Click="OnRescan" />
                <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="14,0,0,0" />
            </DockPanel>
        </StackPanel>

        <!-- Giữa: danh sách cờ của lệnh đang chọn. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="20,0,20,0">
            <StackPanel x:Name="RowsPanel" />
        </ScrollViewer>
    </DockPanel>
</Window>
