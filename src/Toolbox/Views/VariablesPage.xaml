<UserControl x:Class="Toolbox.Views.VariablesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Toolbox.Views"
             PreviewKeyDown="OnPreviewKeyDown">
    <UserControl.Resources>
        <!-- Controls.xaml chưa có style PasswordBox: dùng cùng dáng với TextBox để ô secret không lệch theme. -->
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InputLineHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Danh sách nhóm (giống Library › Variable groups của ADO). -->
        <DockPanel Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="OnNewGroup" Margin="8,0,0,0"
                    AutomationProperties.Name="Thêm nhóm biến">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,6,0" />
                    <TextBlock Text="Nhóm biến" />
                </StackPanel>
            </Button>
            <v:SearchField x:Name="FilterBox" DockPanel.Dock="Right" Width="220" TextChanged="OnFilter" Placeholder="Lọc nhóm…" />
            <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="Bộ biến môi trường đặt tên của workspace. Gắn một nhóm vào lệnh đã ghim để lệnh chạy với giá trị của nhóm." />
        </DockPanel>

        <TextBlock x:Name="EmptyHint" Style="{StaticResource Hint}" Margin="0,4,0,12"
                   Text="Chưa có nhóm biến. Bấm &quot;+ Nhóm biến&quot; để tạo, vd. Dev-A và Dev-B với chuỗi kết nối khác nhau." />

        <Border x:Name="ListCard" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                CornerRadius="10" Padding="4,4" Margin="0,0,0,16">
            <StackPanel>
                <Grid Margin="10,4,10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="104" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="TÊN" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Faint}" />
                    <TextBlock Grid.Column="1" Text="MÔ TẢ" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Faint}" />
                    <TextBlock Grid.Column="2" Text="BIẾN" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Faint}" />
                    <TextBlock Grid.Column="3" Text="ĐANG DÙNG" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Faint}" />
                    <TextBlock Grid.Column="4" Text="SỬA LẦN CUỐI" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Faint}" />
                </Grid>
                <ItemsControl x:Name="GroupList" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="OnPickGroup" HorizontalContentAlignment="Stretch" Padding="0" Margin="0,1"
                                    Style="{StaticResource GhostButton}" AutomationProperties.Name="{Binding Name, StringFormat='Mở nhóm {0}'}">
                                <Border CornerRadius="6" Padding="10,7">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="104" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Ink}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1"
                                                    CornerRadius="9" Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding NeedsInputVisibility}" ToolTip="Có secret chưa có giá trị, lệnh dùng nhóm này sẽ báo lỗi">
                                                <TextBlock Text="cần nhập" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WarnInk}" />
                                            </Border>
                                            <Border Background="{DynamicResource TagBg}" CornerRadius="9" Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding AgentOffVisibility}" ToolTip="Agent không thấy và không dùng được nhóm này">
                                                <TextBlock Text="ẩn với agent" FontSize="11" Foreground="{DynamicResource TagInk}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Description}" Foreground="{DynamicResource Muted}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Count}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding UsedText}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding ModifiedText}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="NoMatch" Style="{StaticResource Hint}" Margin="10,6,10,6" Visibility="Collapsed"
                           Text="Không có nhóm nào khớp ô lọc." />
            </StackPanel>
        </Border>

        <!-- Editor: Thuộc tính + Biến. -->
        <Border x:Name="EditorCard" Visibility="Collapsed" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
                BorderThickness="1" CornerRadius="10" Padding="16,14">
            <StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="Lưu" Click="OnSave" MinWidth="72"
                                ToolTip="Lưu nhóm biến (Ctrl+S)" AutomationProperties.Name="Lưu nhóm biến" />
                        <Button x:Name="CloneButton" Style="{StaticResource SoftButton}" Content="Nhân bản" Click="OnClone" Margin="6,0,0,0"
                                ToolTip="Tạo nhóm mới từ nhóm này; secret được giữ nguyên (đã mã hoá)" />
                        <Button x:Name="DeleteButton" Style="{StaticResource DangerButton}" Content="Xoá" Click="OnDelete" Margin="6,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Biến › " Foreground="{DynamicResource Muted}" FontSize="15" />
                        <TextBlock x:Name="EditorTitle" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="320" />
                        <TextBlock x:Name="DirtyText" Text="●  chưa lưu" Foreground="{DynamicResource WarnInk}" FontSize="12"
                                   Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                    </StackPanel>
                </DockPanel>

                <TextBlock Text="THUỘC TÍNH" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Faint}" Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Tên *" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NameBox" TextChanged="OnPropertyChanged" AutomationProperties.Name="Tên nhóm biến" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Mô tả" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="DescriptionBox" TextChanged="OnPropertyChanged" AutomationProperties.Name="Mô tả nhóm biến" />
                    </StackPanel>
                </Grid>
                <CheckBox x:Name="AgentBox" Margin="0,10,0,0" Content="Cho agent dùng nhóm này" Click="OnPropertyChanged"
                          ToolTip="Tắt thì agent không thấy nhóm, không gắn và không chạy được với nhóm này." />
                <TextBlock x:Name="UsedByText" Style="{StaticResource Hint}" Margin="0,6,0,0" />

                <DockPanel Margin="0,18,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Click="OnAddVariable" AutomationProperties.Name="Thêm biến">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="Thêm" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="BIẾN" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" />
                </DockPanel>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Tên" Foreground="{DynamicResource Muted}" FontSize="12" />
                    <TextBlock Grid.Column="2" Text="Giá trị" Foreground="{DynamicResource Muted}" FontSize="12" />
                    <TextBlock Grid.Column="4" Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="12" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Muted}"
                               ToolTip="Bấm khoá để đổi biến thành secret: mã hoá khi lưu và không xem lại được" />
                </Grid>
                <StackPanel x:Name="VariableRows" />
                <TextBlock x:Name="NoVariables" Style="{StaticResource Hint}" Text="Nhóm chưa có biến. Bấm &quot;Thêm&quot;." Visibility="Collapsed" />

                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                           Visibility="Collapsed" />
                <TextBlock x:Name="WarnText" Foreground="{DynamicResource WarnInk}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="Collapsed" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                           Text="Secret được mã hoá trên máy này (Windows DPAPI, chỉ tài khoản Windows này giải mã được) và không có cách xem lại; chỉ ghi đè. Lệnh nhận biến qua môi trường của tiến trình. Nếu tham số của lệnh dùng %TÊN% để chèn secret, giá trị lộ trong danh sách tiến trình của máy." />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
