<UserControl x:Class="Toolbox.Views.RunDock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="12,5">
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="OnAll" Content="Xem tác vụ" Padding="10,2" MinHeight="26"
                    AutomationProperties.Name="Mở trang Tác vụ" />
            <TextBlock DockPanel.Dock="Right" x:Name="Summary" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Muted}" Margin="12,0" />
            <TextBlock x:Name="Idle" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Muted}" Text="Không có tác vụ chạy ngầm" />
            <ItemsControl x:Name="Chips" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Chip" Background="{DynamicResource OkSoft}" BorderBrush="{DynamicResource OkLine}" BorderThickness="1"
                                CornerRadius="14" Padding="10,2,4,2" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource Ok}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12" />
                                <TextBlock Text="{Binding PortText}" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                <Button Style="{StaticResource GhostButton}" Content="Mở" Click="OnOpen" Tag="{Binding}" Visibility="{Binding OpenVisibility}"
                                        Padding="8,0" MinHeight="22" Margin="6,0,0,0" BorderThickness="0" Background="Transparent" FontSize="12" />
                                <Button Style="{StaticResource GhostButton}" Content="Log" Click="OnLog" Tag="{Binding}"
                                        Padding="8,0" MinHeight="22" BorderThickness="0" Background="Transparent" FontSize="12" />
                                <Button Style="{StaticResource GhostButton}" Content="{Binding LastActionText}" Click="OnLast" Tag="{Binding}"
                                        Padding="8,0" MinHeight="22" BorderThickness="0" Background="Transparent" FontSize="12" />
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Failed}" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource DangerSoft}" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource DangerLine}" />
                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Danger}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
</UserControl>
