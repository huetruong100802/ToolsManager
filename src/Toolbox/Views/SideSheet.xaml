<UserControl x:Class="Toolbox.Views.SideSheet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Stretch" Focusable="False">
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
        <Border.Effect>
            <DropShadowEffect Direction="180" ShadowDepth="0" BlurRadius="20" Opacity="0.18" Color="#000000" />
        </Border.Effect>
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="20,14,12,10">
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12"
                        Width="30" Height="30" MinHeight="30" Padding="0" BorderThickness="0" Background="Transparent" Click="OnCloseClick"
                        AutomationProperties.Name="Đóng" ToolTip="Đóng (Esc)" />
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" />
            <ContentPresenter x:Name="Body" />
        </DockPanel>
    </Border>
</UserControl>
