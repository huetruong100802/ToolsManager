<v:SheetBase x:Class="Toolbox.Views.CommandEditSheet"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Toolbox.Views"
        Background="{DynamicResource Surface}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Huỷ" IsCancel="True" Click="OnCancel" MinWidth="90" Margin="0,0,8,0" />
                <Button x:Name="OkButton" Content="Lưu" IsDefault="True" Click="OnOk" MinWidth="90"
                        Style="{StaticResource PrimaryButton}" IsEnabled="False" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16,20,8">
                <TextBlock Text="Tên lệnh *" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="LabelBox" TextChanged="OnChanged" AutomationProperties.Name="Tên lệnh" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,14" TextWrapping="Wrap"
                           Text="Hiện trên nút và trong danh sách tác vụ, vd: Chạy mock API." />

                <TextBlock Text="Dòng lệnh *" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="CommandBox" TextChanged="OnChanged" FontFamily="Consolas" AutomationProperties.Name="Dòng lệnh"
                         ToolTip="vd: python -m http.server 8000" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,14" TextWrapping="Wrap"
                           Text="Chạy bằng cmd.exe tại thư mục bên dưới. Không tự thêm tham số." />

                <TextBlock Text="Thư mục chạy" Style="{StaticResource FieldLabel}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Chọn thư mục…" Click="OnBrowse" Margin="8,0,0,0" />
                    <TextBox x:Name="CwdBox" TextChanged="OnChanged" AutomationProperties.Name="Thư mục chạy" />
                </DockPanel>
                <TextBlock x:Name="CwdHint" Style="{StaticResource Hint}" Margin="0,4,0,14" TextWrapping="Wrap" />

                <CheckBox x:Name="WindowCheck" Content="Mở trong cửa sổ terminal riêng" Margin="0,0,0,4"
                          ToolTip="Dùng cho lệnh cần nhập tay hoặc xem trực tiếp; chế độ này không có log trong Toolbox" />
                <TextBlock Style="{StaticResource Hint}" Margin="22,0,0,14" TextWrapping="Wrap"
                           Text="Bỏ chọn: chạy ngầm, xem log trong Toolbox. Chọn: cửa sổ riêng, nhập được nhưng không có log." />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</v:SheetBase>
