<UserControl x:Class="Toolbox.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20">
            <TextBlock Text="Tổng quan" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="Subtitle" Style="{StaticResource Hint}" Margin="0,4,0,16" />

            <UniformGrid Columns="3">
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="10" Padding="16,14" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="WORKSPACE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Faint}" />
                        <TextBlock x:Name="WorkspaceCount" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <TextBlock x:Name="WorkspaceDetail" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="10" Padding="16,14" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="ĐANG CHẠY" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Faint}" />
                        <TextBlock x:Name="RunningCount" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <TextBlock x:Name="RunningDetail" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="10" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="CỔNG ĐANG DÙNG" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Faint}" />
                        <TextBlock x:Name="PortList" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="Cổng của các tác vụ đang chạy" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="WORKSPACE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Faint}" Margin="2,24,0,6" />
            <ItemsControl x:Name="WorkspaceList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Click="OnWorkspaceClick"
                                Margin="0,0,0,6" ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Name}">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Visibility="{Binding RunningVisibility}" Background="{StaticResource OkSoft}"
                                        BorderBrush="{StaticResource OkLine}" BorderThickness="1" CornerRadius="9" Padding="6,0"
                                        Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="Số tác vụ đang chạy ngầm">
                                    <TextBlock Text="{Binding RunningCount}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Ok}" />
                                </Border>
                                <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{Binding ColorBrush}" Margin="0,0,10,0"
                                         VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Path}" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="NoWorkspaceNote" Style="{StaticResource Hint}" Text="Chưa có workspace. Thêm một thư mục repo ở rail bên trái." />

            <TextBlock Text="GẦN ĐÂY" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Faint}" Margin="2,24,0,6" />
            <ItemsControl x:Name="RecentList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Xem log" Click="OnShowLog"
                                    Margin="8,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Xem log tác vụ" />
                            <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{Binding StateBrush}" Margin="4,0,10,0"
                                     VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding WorkspaceName, Mode=OneWay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding StateText, Mode=OneWay}" />
                                    <Run Text="{Binding PortText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="NoRecentNote" Style="{StaticResource Hint}" Text="Chưa có tác vụ nào." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
