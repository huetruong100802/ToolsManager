<v:SheetBase x:Class="Toolbox.Views.ActionSheet"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Toolbox.Views"
        Background="{DynamicResource Surface}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="Ghim lệnh" Click="OnPin" MinWidth="90" HorizontalAlignment="Left"
                        ToolTip="Ghim cách chạy này (lệnh + tham số) lên đầu danh sách" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Đóng" IsCancel="True" MinWidth="90" Margin="0,0,8,0" />
                    <Button Content="Chạy" IsDefault="True" Click="OnRun" MinWidth="90" Style="{StaticResource PrimaryButton}"
                            IsEnabled="{Binding CanRun}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16,20,12">
                <TextBlock x:Name="Heading" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="Note" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2,0,12" />

                <ComboBox ItemsSource="{Binding Variants}" SelectedItem="{Binding Variant, Mode=TwoWay}"
                          DisplayMemberPath="Label" HorizontalAlignment="Left" MinWidth="240" Margin="0,0,0,8"
                          Visibility="{Binding VariantPickerVisibility}" AutomationProperties.Name="Cách chạy" />
                <ItemsControl ItemsSource="{Binding VisibleParams}" Visibility="{Binding VisibleParamsVisibility}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="{Binding Prompt}" Style="{StaticResource FieldLabel}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Width="32" Click="OnPickOptions"
                                            Visibility="{Binding OptionsVisibility}"
                                            ToolTip="Chọn từ danh sách gợi ý" AutomationProperties.Name="{Binding Prompt, StringFormat='Chọn gợi ý cho {0}'}">
                                        <Path Data="M 0,0 L 8,0 L 4,5 Z" Fill="{DynamicResource Muted}" Width="8" Height="5" Stretch="Fill" />
                                    </Button>
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{Binding Prompt}"
                                             ToolTip="{Binding Default, StringFormat='Để trống = {0}'}" />
                                </DockPanel>
                                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,3,0,0" Visibility="{Binding ErrorVisibility}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Tham số thêm" Style="{StaticResource FieldLabel}" Margin="0,4,0,0" />
                <ContentControl x:Name="EditorHost" Focusable="False" IsTabStop="False" />
                <TextBlock Text="{Binding Preview}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource Muted}"
                           TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</v:SheetBase>
