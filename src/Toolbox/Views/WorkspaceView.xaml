<UserControl x:Class="Toolbox.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Toolbox.Views">
    <UserControl.Resources>
        <!-- Tab tool: chữ đậm và gạch chân accent khi chọn. -->
        <Style x:Key="TabButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="14,10,14,8" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nhãn "Đang chạy" dùng chung cho action, profile và lệnh riêng. -->
        <DataTemplate x:Key="RunningBadge">
            <Border Background="{DynamicResource OkSoft}" BorderBrush="{DynamicResource OkLine}" BorderThickness="1" CornerRadius="9"
                    Padding="7,0" Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding RunningText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Ok}" />
            </Border>
        </DataTemplate>
        <!-- Dòng dùng chung cho tab tool và tab Chạy. -->
                            <DataTemplate x:Key="StackRowTemplate">
                                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                        CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                                                <Button Style="{StaticResource PrimaryButton}" Content="Chạy" Click="OnRunStack" MinWidth="72"
                                                        IsEnabled="{Binding CanRun}" ToolTip="{Binding RunTip}" Visibility="{Binding RunVisibility}" />
                                                <Button Style="{StaticResource DangerButton}" Content="Dừng" Click="OnStopStack" MinWidth="72"
                                                        Visibility="{Binding StopVisibility}" />
                                                <Button Style="{StaticResource GhostButton}" Click="OnRowMenu" Margin="4,0,0,0"
                                                        AutomationProperties.Name="Thêm" ToolTip="Sửa bằng sơ đồ, sửa dạng danh sách, xoá">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE712;" FontSize="14" />
                                                </Button>
                                            </StackPanel>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Foreground="{DynamicResource Ink}" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <Border Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentSoftLine}" BorderThickness="1" CornerRadius="9"
                                                        Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding NewVisibility}"
                                                        ToolTip="Agent vừa thêm hoặc sửa mục này">
                                                    <TextBlock Text="mới" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                                                </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{DynamicResource Muted}" />
                                            </StackPanel>
                                        </DockPanel>

                                        <ItemsControl ItemsSource="{Binding Steps}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,2">
                                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Width="20" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Faint}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="Done">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Ok}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="Running">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="Failed">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ElapsedText}" FontSize="12"
                                                                   Foreground="{DynamicResource Accent}" Margin="12,0,0,0" />
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding WaitText}" FontSize="12"
                                                                   Foreground="{DynamicResource Faint}" Margin="12,0,0,0" />
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                                   Margin="12,0,0,0" MaxWidth="320" ToolTip="{Binding Note}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsBroken}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Foreground="{DynamicResource Ink}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="{Binding Message}" Visibility="{Binding MessageVisibility}" TextWrapping="Wrap"
                                                   Margin="0,8,0,0" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MessageKind}" Value="ok">
                                                            <Setter Property="Foreground" Value="{DynamicResource Ok}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding MessageKind}" Value="error">
                                                            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding FailedVisibility}">
                                            <Button Style="{StaticResource SoftButton}" Content="{Binding RetryText}" Click="OnRetryStack"
                                                    AutomationProperties.Name="Chạy lại từ bước lỗi" />
                                            <Button Style="{StaticResource GhostButton}" Content="Mở log bước lỗi" Click="OnFailedLog" Margin="8,0,0,0"
                                                    Visibility="{Binding FailedLogVisibility}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- Ba tab cố định: Chạy (mọi lệnh), Workflow, Chia sẻ. Quản lý tool nằm ở menu bên phải. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                Padding="12,0,12,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="OnConnectAgent" VerticalAlignment="Center"
                        AutomationProperties.Name="Kết nối agent" ToolTip="Cho Claude Code dùng workspace này qua MCP; agent chỉ thấy workspace này">
                    <TextBlock Text="Kết nối agent" />
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="OnToolMenu" VerticalAlignment="Center"
                        AutomationProperties.Name="Tool của workspace" ToolTip="Thêm, sửa, gỡ tool gắn vào workspace này; lệnh riêng; worktree">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Tool của workspace…" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="TabStrip">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource TabButton}" Click="OnTabClick" Content="{Binding Title}"
                                             IsChecked="{Binding IsSelected, Mode=OneWay}" AutomationProperties.Name="{Binding Title}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="20,16,20,20">
                <!-- Trang Chạy: mọi lệnh của workspace trong một danh sách, nhóm theo tool; lệnh đã ghim ở đầu. -->
                <StackPanel x:Name="RunPage">
                    <v:ReadinessPanel x:Name="ReadyPanel" />
                    <TextBlock Text="WORKFLOW" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Faint}" Margin="2,0,0,6" />
                    <TextBlock x:Name="NoRunStacks" Style="{StaticResource Hint}" Margin="0,0,0,8"
                               Text="Chưa có workflow. Mở tab &quot;Workflow&quot; để gom nhiều bước thành một nút chạy." />
                    <ItemsControl x:Name="RunStackList" ItemTemplate="{StaticResource StackRowTemplate}" />

                    <DockPanel Margin="0,16,0,4">
                        <v:SearchField x:Name="RunSearch" DockPanel.Dock="Right" Width="260" TextChanged="OnRunSearch"
                                       Placeholder="Tìm lệnh theo tên…" />
                        <TextBlock Text="LỆNH" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Faint}"
                                   Margin="2,0,0,0" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock x:Name="NoRunItems" Style="{StaticResource Hint}" Margin="0,4,0,8" Visibility="Collapsed" />
                    <Button x:Name="AskSetupButton" Style="{StaticResource SoftButton}" Content="AI thiết lập…" Click="OnAskSetup"
                            HorizontalAlignment="Left" Margin="0,0,0,10" Visibility="Collapsed"
                            ToolTip="Gọi CLI agent đọc dự án và đề xuất lệnh để bạn duyệt" />

                    <ItemsControl x:Name="RunList" IsTabStop="False">
                        <ItemsControl.Resources>
                            <!-- Tiêu đề nhóm: tên tool, "Lệnh riêng"; tool có menu ⋯ (lệnh, thư mục chạy, gỡ). -->
                            <DataTemplate DataType="{x:Type v:GroupRow}">
                                <StackPanel Margin="0,16,0,2">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="OnGroupMenu"
                                                Visibility="{Binding MenuVisibility}" AutomationProperties.Name="Tuỳ chọn của tool"
                                                ToolTip="Lệnh của tool, thư mục chạy, gỡ tool">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE712;" FontSize="14" />
                                        </Button>
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Visibility="{Binding NoteVisibility}" />
                                </StackPanel>
                            </DataTemplate>

                            <DataTemplate DataType="{x:Type v:ActionRow}">
                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="4,7">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <Button Style="{StaticResource PrimaryButton}" Content="Chạy" Click="OnRun" MinWidth="64"
                                                    IsEnabled="{Binding CanRun}" Visibility="{Binding RunVisibility}" />
                                            <Button Style="{StaticResource DangerButton}" Content="Dừng" Click="OnStop" MinWidth="64"
                                                    Visibility="{Binding StopVisibility}" />
                                            <Button Style="{StaticResource GhostButton}" Click="OnPinAction" Margin="4,0,0,0"
                                                    AutomationProperties.Name="Ghim lệnh" ToolTip="Ghim lệnh này lên đầu danh sách">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE718;" FontSize="14" />
                                            </Button>
                                            <Button Style="{StaticResource GhostButton}" Click="OnRowMenu"
                                                    AutomationProperties.Name="Thêm" ToolTip="Tham số, ghim">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE712;" FontSize="14" />
                                            </Button>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Foreground="{DynamicResource Ink}" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RunningBadge}"
                                                                Visibility="{Binding StopVisibility}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Preview}" ToolTip="{Binding Preview}" FontFamily="Consolas" FontSize="12"
                                                       Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>

                            <!-- Lệnh đã ghim (trong JSON vẫn là "profiles"). -->
                            <DataTemplate DataType="{x:Type v:ProfileRow}">
                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="4,7">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <Button Style="{StaticResource PrimaryButton}" Content="Chạy" Click="OnRun" MinWidth="64"
                                                    IsEnabled="{Binding CanRun}" Visibility="{Binding RunVisibility}" />
                                            <Button Style="{StaticResource DangerButton}" Content="Dừng" Click="OnStop" MinWidth="64"
                                                    Visibility="{Binding StopVisibility}" />
                                            <Button Style="{StaticResource GhostButton}" Click="OnDeleteProfile" Margin="4,0,0,0"
                                                    AutomationProperties.Name="Bỏ ghim" ToolTip="Bỏ ghim lệnh này">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE77A;" FontSize="14" Foreground="{DynamicResource Accent}" />
                                            </Button>
                                            <Button Style="{StaticResource GhostButton}" Click="OnRowMenu"
                                                    AutomationProperties.Name="Thêm" ToolTip="Tham số, đổi tên, nhân bản">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE712;" FontSize="14" />
                                            </Button>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Foreground="{DynamicResource Ink}" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <Border Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentSoftLine}" BorderThickness="1" CornerRadius="9"
                                                        Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding NewVisibility}"
                                                        ToolTip="Agent vừa thêm hoặc sửa mục này">
                                                    <TextBlock Text="mới" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                                                </Border>
                                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RunningBadge}"
                                                                Visibility="{Binding StopVisibility}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Problem}" FontSize="12" Foreground="{DynamicResource WarnInk}"
                                                       TextWrapping="Wrap" Visibility="{Binding ProblemVisibility}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>

                            <DataTemplate DataType="{x:Type v:CustomRow}">
                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="4,7">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <Button Style="{StaticResource PrimaryButton}" Content="Chạy" Click="OnRun" MinWidth="64"
                                                    IsEnabled="{Binding CanRun}" Visibility="{Binding RunVisibility}" />
                                            <Button Style="{StaticResource DangerButton}" Content="Dừng" Click="OnStop" MinWidth="64"
                                                    Visibility="{Binding StopVisibility}" />
                                            <Button Style="{StaticResource GhostButton}" Click="OnRowMenu" Margin="4,0,0,0"
                                                    AutomationProperties.Name="Thêm" ToolTip="Sửa, xoá">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE712;" FontSize="14" />
                                            </Button>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Foreground="{DynamicResource Ink}" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <Border Background="{DynamicResource TagBg}" CornerRadius="10" Padding="7,1" Margin="8,0,0,0"
                                                        VerticalAlignment="Center" Visibility="{Binding WindowVisibility}"
                                                        ToolTip="Chạy trong cửa sổ terminal riêng, không có log">
                                                    <TextBlock Text="Cửa sổ" FontSize="11" Foreground="{DynamicResource TagInk}" />
                                                </Border>
                                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RunningBadge}"
                                                                Visibility="{Binding StopVisibility}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding CommandLine}" ToolTip="{Binding CommandLine}" FontFamily="Consolas" FontSize="12"
                                                       Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.Resources>
                    </ItemsControl>
                </StackPanel>

                <!-- Trang "Workflow". -->
                <v:PackTab x:Name="PackPage" Visibility="Collapsed" />

                <StackPanel x:Name="StackPage" Visibility="Collapsed">
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Dựng bằng sơ đồ" Click="OnDiagramNew"
                                VerticalAlignment="Top" Margin="8,0,0,0" AutomationProperties.Name="Dựng workflow bằng sơ đồ" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Nhờ agent dựng…" Click="OnAskWorkflow" VerticalAlignment="Top"
                                Margin="8,0,0,0" ToolTip="Mô tả workflow bạn muốn, Toolbox soạn prompt cho agent" AutomationProperties.Name="Nhờ agent dựng workflow" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Click="OnAddStack" VerticalAlignment="Top"
                                AutomationProperties.Name="Thêm workflow">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="Thêm workflow" />
                            </StackPanel>
                        </Button>
                        <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="Chuỗi lệnh chạy lần lượt bằng một cú bấm, vd: bật API, chờ cổng mở rồi bật web." />
                    </DockPanel>
                    <TextBlock x:Name="NoStacks" Style="{StaticResource Hint}" Text="Chưa có workflow. Bấm &quot;Thêm workflow&quot; để tạo." />
                    <ItemsControl x:Name="StackList" ItemTemplate="{StaticResource StackRowTemplate}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
