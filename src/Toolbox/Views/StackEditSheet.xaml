<v:SheetBase x:Class="Toolbox.Views.StackEditSheet"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Toolbox.Views"
        Background="{DynamicResource Surface}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Huỷ" IsCancel="True" Click="OnCancel" MinWidth="90" Margin="0,0,8,0" />
                <Button x:Name="OkButton" Content="Lưu" IsDefault="True" Click="OnOk" MinWidth="90"
                        Style="{StaticResource PrimaryButton}" IsEnabled="False" />
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top" Margin="20,18,20,8">
            <TextBlock Text="Tên workflow *" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="LabelBox" TextChanged="OnLabelChanged" AutomationProperties.Name="Tên workflow" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,12"
                       Text="vd: Dev full stack. Các bước chạy lần lượt từ trên xuống." />
            <DockPanel>
                <Button x:Name="AddStepButton" DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Click="OnAddStep"
                        AutomationProperties.Name="Thêm bước">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="Thêm bước" />
                    </StackPanel>
                </Button>
                <TextBlock Text="Các bước" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock x:Name="NoTargets" Style="{StaticResource Hint}" Margin="0,6,0,0" Visibility="Collapsed"
                       Text="Workspace chưa có tool hay lệnh riêng nào để ghép. Hãy thêm tool hoặc lệnh riêng trước." />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="20,0,20,8">
            <StackPanel>
                <TextBlock x:Name="NoSteps" Style="{StaticResource Hint}" Text="Chưa có bước nào. Bấm &quot;Thêm bước&quot;." />
                <ItemsControl x:Name="StepList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                    CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                            <Button Style="{StaticResource GhostButton}" Click="OnMoveUp" ToolTip="Lên" AutomationProperties.Name="Đưa bước lên">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE70E;" FontSize="12" />
                                            </Button>
                                            <Button Style="{StaticResource GhostButton}" Click="OnMoveDown" ToolTip="Xuống" AutomationProperties.Name="Đưa bước xuống">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="12" />
                                            </Button>
                                            <Button Style="{StaticResource GhostButton}" Click="OnRemoveStep" ToolTip="Xoá bước" AutomationProperties.Name="Xoá bước">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="12" />
                                            </Button>
                                        </StackPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Number}" FontWeight="SemiBold" Width="22"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
                                        <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding Target, Mode=TwoWay}"
                                                  DisplayMemberPath="Display" AutomationProperties.Name="Lệnh của bước" />
                                    </DockPanel>

                                    <WrapPanel Margin="22,8,0,0">
                                        <StackPanel Margin="0,0,12,4" Visibility="{Binding ProfileVisibility}">
                                            <TextBlock Text="Profile" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile, Mode=TwoWay}"
                                                      DisplayMemberPath="Text" MinWidth="170" AutomationProperties.Name="Profile" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,4" Visibility="{Binding VariantVisibility}">
                                            <TextBlock Text="Biến thể" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding Variants}" SelectedItem="{Binding Variant, Mode=TwoWay}"
                                                      DisplayMemberPath="Label" MinWidth="170" AutomationProperties.Name="Biến thể" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,4">
                                            <TextBlock Text="Sau khi bật" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding WaitOptions}" SelectedItem="{Binding Wait, Mode=TwoWay}"
                                                      DisplayMemberPath="Text" MinWidth="190" AutomationProperties.Name="Chờ gì trước bước kế" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,4" Visibility="{Binding PortVisibility}">
                                            <TextBlock Text="Cổng chờ" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" Width="90"
                                                     ToolTip="Để trống nếu lệnh đã có tham số cổng" AutomationProperties.Name="Cổng chờ" />
                                        </StackPanel>
                                    </WrapPanel>

                                    <TextBlock Text="{Binding Problem}" Visibility="{Binding ProblemVisibility}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Danger}" FontSize="12" Margin="22,4,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</v:SheetBase>
