<UserControl x:Class="Toolbox.Views.ShortcutsSheet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" Focusable="False">
    <Grid Background="{DynamicResource Scrim}" MouseLeftButtonDown="OnScrimClick">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="520" MaxHeight="520"
                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource InputLine}" BorderThickness="1" CornerRadius="12"
                Padding="22,18" MouseLeftButtonDown="OnCardClick">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Đóng (Esc)" Click="OnClose" Padding="10,2" MinHeight="26" />
                    <TextBlock Text="Phím tắt" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="List">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,7">
                                    <Border DockPanel.Dock="Left" Width="150" Background="{DynamicResource TagBg}" CornerRadius="5" Padding="8,3" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Keys}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TagInk}" />
                                    </Border>
                                    <TextBlock Text="{Binding Description}" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
