<UserControl x:Class="Toolbox.Views.SearchField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <TextBox x:Name="Box" Padding="32,6,8,6" TextChanged="OnBoxChanged" KeyDown="OnBoxKeyDown"
                 AutomationProperties.Name="{Binding Placeholder, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Foreground="{DynamicResource Faint}"
                   HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False" />
        <TextBlock x:Name="PlaceholderText" Foreground="{DynamicResource Faint}" Margin="34,0,0,0"
                   VerticalAlignment="Center" IsHitTestVisible="False" />
    </Grid>
</UserControl>
