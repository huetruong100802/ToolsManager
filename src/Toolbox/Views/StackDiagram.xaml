<UserControl x:Class="Toolbox.Views.StackDiagram"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Tên bộ chạy *" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="LabelBox" AutomationProperties.Name="Tên bộ chạy" />
        </StackPanel>

        <!-- Bên trái: profile của workspace, kéo vào dấu + hoặc bấm đúp để thêm vào cuối -->
        <Border DockPanel.Dock="Left" Width="210" Margin="0,0,12,0" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="PROFILE" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource Faint}" Margin="2,0,0,6" />
                <TextBlock x:Name="PaletteHint" DockPanel.Dock="Bottom" Style="{StaticResource Hint}" TextWrapping="Wrap"
                           Margin="2,8,0,0" Text="Kéo profile vào dấu +, hoặc bấm đúp để thêm vào cuối." />
                <ListBox x:Name="Palette" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Danh sách profile"
                         PreviewMouseLeftButtonDown="OnPalettePress" PreviewMouseMove="OnPaletteMove"
                         MouseDoubleClick="OnPaletteDouble" DisplayMemberPath="Label" />
            </DockPanel>
        </Border>

        <!-- Bên phải: sơ đồ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Flow" HorizontalAlignment="Center" Margin="0,4,0,12" MinWidth="320" />
        </ScrollViewer>
    </DockPanel>
</UserControl>
