<UserControl x:Class="Toolbox.Views.InspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="420">
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
        <Border.Effect>
            <DropShadowEffect Direction="180" ShadowDepth="0" BlurRadius="16" Opacity="0.12" />
        </Border.Effect>
        <DockPanel Margin="18,14">
            <DockPanel DockPanel.Dock="Top">
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Đóng" Click="OnClose"
                        AutomationProperties.Name="Đóng log" />
                <TextBlock Text="Log tác vụ" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Faint}"
                           VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock x:Name="Title" DockPanel.Dock="Top" FontSize="15" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" Margin="0,10,0,0" />
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock x:Name="StateLabel" FontWeight="SemiBold" />
                <TextBlock x:Name="Meta" Foreground="{DynamicResource Muted}" Margin="10,0,0,0" />
            </StackPanel>
            <TextBlock x:Name="Cwd" DockPanel.Dock="Top" Foreground="{DynamicResource Muted}" FontSize="12"
                       TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
            <TextBlock x:Name="Command" DockPanel.Dock="Top" FontFamily="Consolas" FontSize="12"
                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            <Border x:Name="HintCard" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,10,0,0" Padding="12,10" CornerRadius="8"
                    Background="{DynamicResource DangerSoft}" BorderBrush="{DynamicResource DangerLine}" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="HintTitle" FontWeight="SemiBold" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" />
                    <TextBlock x:Name="HintExplain" Margin="0,3,0,0" FontSize="12" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="HintActionButton" Style="{StaticResource SoftButton}" Click="OnHintAction" Padding="12,3" MinHeight="26" />
                        <Button x:Name="CopyAgentButton" Style="{StaticResource GhostButton}" Content="Sao chép cho agent" Click="OnCopyForAgent"
                                Padding="12,3" MinHeight="26" Margin="8,0,0,0"
                                ToolTip="Sao chép lệnh, thư mục tương đối và 40 dòng log cuối để dán cho agent" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="StopButton" Style="{StaticResource DangerButton}" Content="Dừng" Click="OnStop" />
                <Button x:Name="RestartButton" Style="{StaticResource SoftButton}" Content="Chạy lại" Click="OnRestart"
                        Margin="8,0,0,0" />
                <Button x:Name="OpenLogButton" Style="{StaticResource GhostButton}" Content="Mở file log" Click="OnOpenLog"
                        Margin="8,0,0,0" />
            </StackPanel>

            <Border Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="8" Margin="0,12,0,0">
                <TextBox x:Name="Log" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                         BorderThickness="0" Background="Transparent" Padding="10,8"
                         AutomationProperties.Name="Nội dung log" />
            </Border>
        </DockPanel>
    </Border>
</UserControl>
