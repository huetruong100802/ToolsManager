<UserControl x:Class="Toolbox.Views.ReadinessPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <Border x:Name="Card" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="10"
            Padding="14,10" Margin="0,0,0,14">
        <StackPanel>
            <TextBlock x:Name="Heading" FontWeight="SemiBold" Foreground="{DynamicResource WarnInk}" />
            <TextBlock x:Name="SubHeading" Style="{StaticResource Hint}" Margin="0,2,0,8"
                       Text="Máy này còn thiếu vài thứ để chạy hết mọi thứ trong workspace. Mỗi dòng có nút sửa." />
            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,4">
                            <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="{Binding FixText}" Click="OnFix" Tag="{Binding Issue}"
                                    Visibility="{Binding FixVisibility}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="14" Width="22"
                                       Foreground="{Binding GlyphBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource Ink}" Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
