<UserControl x:Class="Toolbox.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="LogRow" Height="260" MinHeight="140" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Tác vụ" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="Summary" Style="{StaticResource Hint}" Margin="0,4,0,12" />
        </StackPanel>

        <!-- Bộ lọc: trạng thái, workspace, tìm; Dừng tất cả ở đầu bên phải -->
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" x:Name="StopAllButton" Style="{StaticResource DangerButton}" Content="Dừng tất cả"
                    Click="OnStopAll" Margin="12,0,0,6" VerticalAlignment="Top" />
            <WrapPanel>
                <ToggleButton x:Name="FilterAll" Style="{StaticResource FilterChip}" Content="Tất cả" IsChecked="True"
                              Click="OnFilterChip" Tag="All" />
                <ToggleButton x:Name="FilterRunning" Style="{StaticResource FilterChip}" Content="Đang chạy"
                              Click="OnFilterChip" Tag="Running" />
                <ToggleButton x:Name="FilterFailed" Style="{StaticResource FilterChip}" Content="Lỗi"
                              Click="OnFilterChip" Tag="Failed" />
                <ToggleButton x:Name="FilterFinished" Style="{StaticResource FilterChip}" Content="Đã xong"
                              Click="OnFilterChip" Tag="Finished" />
                <ComboBox x:Name="WorkspaceFilter" MinWidth="170" Margin="8,0,8,6" SelectionChanged="OnFilterChanged"
                          AutomationProperties.Name="Lọc theo workspace" />
                <TextBox x:Name="TaskSearch" MinWidth="180" Margin="0,0,0,6" TextChanged="OnFilterChanged"
                         ToolTip="Tìm theo tên hoặc lệnh" AutomationProperties.Name="Tìm tác vụ" />
            </WrapPanel>
        </DockPanel>

        <TextBlock x:Name="EmptyHint" Grid.Row="2" Style="{StaticResource Hint}" Visibility="Collapsed" Margin="0,0,0,8" />

        <ItemsControl x:Name="TaskList" Grid.Row="3" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Surface}" BorderBrush="{Binding RowBorder}" BorderThickness="1"
                                CornerRadius="10" Padding="14,10" Margin="0,0,0,8" Cursor="Hand"
                                MouseLeftButtonUp="OnSelectRow">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Button Style="{StaticResource DangerButton}" Content="Dừng" Click="OnStop"
                                            Visibility="{Binding StopVisibility}" />
                                    <Button Style="{StaticResource SoftButton}" Content="Chạy lại" Click="OnRestart" Margin="6,0,0,0"
                                            Visibility="{Binding RestartVisibility}" />
                                </StackPanel>
                                <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{Binding StateBrush}"
                                         VerticalAlignment="Top" Margin="0,6,12,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding WorkspaceName, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding StateText, Mode=OneWay}" />
                                        <Run Text="{Binding PortText, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding TimeText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
        </ItemsControl>

        <GridSplitter Grid.Row="4" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      Background="Transparent" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />

        <!-- Khung log của tác vụ đang chọn -->
        <Border Grid.Row="5" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                CornerRadius="10" Padding="14,10">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <CheckBox x:Name="ErrorsOnly" Content="Chỉ hiện lỗi" VerticalAlignment="Center" Margin="0,0,10,0"
                                  Click="OnLogFilterChanged" />
                        <TextBox x:Name="LogSearch" Width="160" TextChanged="OnLogFilterChanged" VerticalAlignment="Center"
                                 ToolTip="Tìm trong log" AutomationProperties.Name="Tìm trong log" />
                        <Button x:Name="OpenFileButton" Style="{StaticResource GhostButton}" Content="Mở file log" Click="OnOpenLogFile"
                                Margin="8,0,0,0" />
                        <Button x:Name="DetachButton" Style="{StaticResource GhostButton}" Content="Mở cửa sổ riêng" Click="OnDetach"
                                Margin="4,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="LogTitle" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Text="Log" />
                </DockPanel>
                <Border Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        CornerRadius="8" Margin="0,8,0,0">
                    <TextBox x:Name="Log" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                             BorderThickness="0" Background="Transparent" Padding="10,8"
                             AutomationProperties.Name="Nội dung log" />
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
