<UserControl x:Class="Toolbox.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Toolbox.Views"
             Background="{DynamicResource WindowBg}" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" PreviewKeyDown="OnWindowKeyDown">
    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
                BorderThickness="0,0,0,1" Padding="20,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Click="OnConnectAgent" Margin="0,0,6,0"
                            AutomationProperties.Name="Kết nối agent…">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE71B;" Margin="0,0,7,0" />
                            <TextBlock Text="Kết nối agent…" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnImport" Margin="0,0,8,0" AutomationProperties.Name="Nhập gói…">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Margin="0,0,7,0" />
                            <TextBlock Text="Nhập gói…" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnPickApp" Margin="0,0,8,0" AutomationProperties.Name="App đã cài…"
                            ToolTip="Chọn từ các app có trong Start Menu">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE71D;" Margin="0,0,7,0" />
                            <TextBlock Text="App đã cài…" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Click="OnAdd" AutomationProperties.Name="+ Thêm tool">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,7,0" />
                            <TextBlock Text="Thêm tool" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Thư viện" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Tool trên máy, đóng gói gửi đồng đội" Foreground="{DynamicResource Muted}" FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
                BorderThickness="0,1,0,0" Padding="20,10">
            <DockPanel>
                <Button x:Name="PackButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Đóng gói"
                        Click="OnPack" IsEnabled="False" />
                <Button x:Name="RemoveButton" DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="Xoá khỏi danh sách"
                        Click="OnRemove" IsEnabled="False" Margin="0,0,8,0" />
                <TextBlock x:Name="RunningText" DockPanel.Dock="Right" Foreground="{DynamicResource Ok}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,16,0" Visibility="Collapsed" />
                <CheckBox x:Name="SelectAll" DockPanel.Dock="Left" Content="Chọn tất cả" VerticalAlignment="Center" Margin="0,0,16,0"
                          Click="OnSelectAll" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <DockPanel Margin="20,14,20,0">
            <Border x:Name="InstallBanner" DockPanel.Dock="Top" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentSoftLine}"
                    BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Cài vào máy" Click="OnInstall" Margin="12,0,0,0" />
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{DynamicResource Accent}"
                               FontSize="16" Margin="0,0,10,0" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="Toolbox chưa được cài. Cài để có shortcut trong Start Menu và double-click file .toolbox là nhập gói (không cần quyền admin)." />
                </DockPanel>
            </Border>

            <!-- Tìm + lọc tag -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <!-- Ô tìm + nút Tag: bấm Tag để mở bảng chọn nhiều tag. -->
                <DockPanel>
                    <ToggleButton x:Name="TagToggle" DockPanel.Dock="Right" Style="{StaticResource TagPickerButton}" Margin="10,0,0,0"
                                  Checked="OnTagPanelToggled" Unchecked="OnTagPanelToggled" ToolTip="Lọc theo nhiều tag">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Tag" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border x:Name="TagBadge" Background="{DynamicResource AccentFill}" CornerRadius="9" Padding="6,0" Margin="8,0,0,0"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="TagBadgeText" Foreground="{DynamicResource OnAccent}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" Foreground="{DynamicResource Muted}"
                                       Margin="10,0,0,0" />
                        </StackPanel>
                    </ToggleButton>

                    <Grid>
                        <TextBox x:Name="SearchBox" Padding="32,6,8,6" TextChanged="OnFilterChanged"
                                 AutomationProperties.Name="Tìm" ToolTip="Ctrl+K hoặc Ctrl+F để tìm nhanh, Esc để xoá" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Foreground="{DynamicResource Faint}"
                                   HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False" />
                        <TextBlock Text="Tìm theo tên, mô tả, tag…  (Ctrl+K)" Foreground="{DynamicResource Faint}" Margin="34,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>

                <!-- Tag đang lọc: mỗi tag là một pill, bấm để bỏ. Ẩn khi chưa chọn tag nào. -->
                <DockPanel x:Name="ActiveTagsRow" Margin="0,8,0,0" Visibility="Collapsed">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Bỏ hết" Click="OnClearTags"
                            VerticalAlignment="Center" Margin="8,0,0,0" />
                    <TextBlock DockPanel.Dock="Left" Text="Đang lọc" Foreground="{DynamicResource Muted}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ItemsControl x:Name="ActiveTags">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ActiveTagPill}" Click="OnActiveTagRemoved" ToolTip="Bỏ lọc tag này">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="9" Margin="7,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </StackPanel>

            <Grid>
                <!-- Bảng chọn tag nổi trên danh sách (không đẩy danh sách xuống). Chỉ hiện khi bấm nút Tag. -->
                <Border x:Name="TagPanel" Visibility="Collapsed" VerticalAlignment="Top" Margin="0,6,0,0" Panel.ZIndex="1"
                        Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        CornerRadius="12" Padding="14,12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.14" Color="#141B2D" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                   Text="Chọn một hoặc nhiều tag. Tool khớp bất kỳ tag nào đã chọn sẽ hiện." />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="180">
                            <ItemsControl x:Name="TagChips">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton Style="{StaticResource FilterChip}" IsChecked="{Binding IsSelected}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                <Border x:Name="CountPill" Background="{DynamicResource Line}" CornerRadius="8" Padding="5,0"
                                                        Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="CountText" Text="{Binding Count}" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Muted}" />
                                                </Border>
                                            </StackPanel>
                                        </ToggleButton>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="CountPill" Property="Background" Value="{DynamicResource AccentFillHover}" />
                                                <Setter TargetName="CountText" Property="Foreground" Value="{DynamicResource OnAccent}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <ListBox x:Name="ToolList" HorizontalContentAlignment="Stretch" MouseDoubleClick="OnListDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Grid Grid.Column="1" Width="38" Height="38" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Border CornerRadius="10" Background="{DynamicResource AccentSoft}">
                                        <Grid>
                                            <TextBlock Text="{Binding Initial}" Visibility="{Binding InitialVisibility}" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{Binding Icon}" Visibility="{Binding IconVisibility}" Width="26" Height="26"
                                                   RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" Stroke="{DynamicResource Surface}" StrokeThickness="2"
                                             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4"
                                             ToolTip="{Binding StatusTip}" />
                                </Grid>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <!-- Tên co lại khi hẹp; tag nằm cột riêng bên phải, tối đa MaxVisibleTags chip. -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Tool.Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding AllTagsTip}">
                                            <ItemsControl ItemsSource="{Binding VisibleTags}" ItemTemplate="{StaticResource TagChip}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                            <Border Background="{DynamicResource TagBg}" CornerRadius="10" Padding="7,1" Margin="0,0,4,0"
                                                    VerticalAlignment="Center" Visibility="{Binding MoreTagsVisibility}">
                                                <TextBlock Text="{Binding MoreTags}" FontSize="11" Foreground="{DynamicResource TagInk}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding Tool.Description}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0" />
                                    <!-- DockPanel (không phải StackPanel ngang) để cảnh báo dài bị cắt bằng dấu …, không tràn sang nút. -->
                                    <DockPanel Visibility="{Binding WarningVisibility}" Margin="0,3,0,0">
                                        <DockPanel.Style>
                                            <Style TargetType="DockPanel">
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Danger}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanInstall}" Value="True">
                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource WarnInk}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DockPanel.Style>
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="12" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Warning}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <!-- Đang chạy: viên thuốc xanh có chấm nhấp nháy + thời gian chạy. -->
                                    <Border Visibility="{Binding UptimeVisibility}" Background="{DynamicResource OkSoft}" BorderBrush="{DynamicResource OkLine}"
                                            BorderThickness="1" CornerRadius="12" Padding="9,3" Margin="0,0,10,0" VerticalAlignment="Center"
                                            ToolTip="Tool đang chạy. Bấm Dừng để tắt.">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Ok}" Margin="0,0,7,0" VerticalAlignment="Center">
                                                <Ellipse.Triggers>
                                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.9" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Ellipse.Triggers>
                                            </Ellipse>
                                            <TextBlock Text="{Binding UptimeText}" Foreground="{DynamicResource Ok}" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                    <!-- Không còn chạy: kết quả lần trước ("Lỗi mã 1 · 3 phút trước"). -->
                                    <TextBlock Visibility="{Binding ResultVisibility}" Text="{Binding ResultText}" Foreground="{Binding ResultBrush}"
                                               FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource GhostButton}" Click="OnOpenFolder" Tag="{Binding}" ToolTip="Mở thư mục"
                                            AutomationProperties.Name="{Binding Tool.Name, StringFormat=Mở thư mục {0}}" Width="34" Padding="0">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" />
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" Click="OnEdit" Tag="{Binding}" ToolTip="Sửa"
                                            AutomationProperties.Name="{Binding Tool.Name, StringFormat=Sửa {0}}" Width="34" Padding="0" Margin="2,0,8,0">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" />
                                    </Button>
                                    <Button Style="{StaticResource PrimaryButton}" Click="OnInstallSetup" Tag="{Binding}" Padding="14,4"
                                            Visibility="{Binding InstallVisibility}" AutomationProperties.Name="{Binding Tool.Name, StringFormat=Cài đặt {0}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="12" Margin="0,0,6,0" />
                                            <TextBlock Text="Cài đặt" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" Click="OnBind" Tag="{Binding}" Padding="10,4" Margin="0,0,6,0"
                                            AutomationProperties.Name="Gắn vào workspace" ToolTip="Chọn workspace sẽ dùng tool này">
                                        <TextBlock Text="Gắn vào workspace…" />
                                    </Button>
                                    <Button Style="{StaticResource SoftButton}" Click="OnRun" Tag="{Binding}" AutomationProperties.Name="{Binding Tool.Name, StringFormat=Chạy {0}}" Padding="14,4"
                                            Visibility="{Binding RunVisibility}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="12" Foreground="{DynamicResource Accent}"
                                                       Margin="0,0,6,0" />
                                            <TextBlock Text="Chạy" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource DangerButton}" Click="OnStop" Tag="{Binding}" Padding="14,4" BorderBrush="{DynamicResource DangerLine}"
                                            Visibility="{Binding StopVisibility}" AutomationProperties.Name="{Binding Tool.Name, StringFormat=Dừng {0}}"
                                            ToolTip="Dừng ngay tool này. Dữ liệu chưa lưu sẽ mất.">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="12" Margin="0,0,6,0" />
                                            <TextBlock Text="Dừng" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Có tool nhưng bộ lọc không khớp cái nào: nói rõ lý do và cho đường thoát, thay vì để danh sách trống. -->
                <StackPanel x:Name="NoResultsHint" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="Không có tool nào khớp" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock Foreground="{DynamicResource Muted}" TextAlignment="Center" Text="Thử từ khoá khác hoặc bỏ bớt tag đang lọc." />
                    <Button Style="{StaticResource SoftButton}" Content="Bỏ lọc" Click="OnClearFilters" HorizontalAlignment="Center" Margin="0,14,0,0" />
                </StackPanel>

                <local:EmptyState x:Name="EmptyHint" Title="Chưa có tool nào"
                                 Body="Chọn app đã cài hoặc thêm file, thư mục, shortcut. Có thể kéo thả vào đây; kéo thả file .toolbox để nhập gói." />
            </Grid>
        </DockPanel>
    </DockPanel>
</UserControl>
