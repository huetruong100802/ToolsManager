<v:SheetBase x:Class="Toolbox.Views.AiSetupSheet"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Toolbox.Views"
        Background="{DynamicResource Surface}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <TextBlock x:Name="Status" DockPanel.Dock="Left" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="Huỷ" MinWidth="90" Margin="0,0,8,0" Click="OnCancel" />
                    <Button x:Name="RetryButton" Content="Chạy lại" MinWidth="90" Margin="0,0,8,0" Click="OnRetry" Visibility="Collapsed" />
                    <Button x:Name="ApplyButton" Content="Thêm lệnh đã chọn" MinWidth="130" Click="OnApply"
                            Style="{StaticResource PrimaryButton}" IsEnabled="False" Visibility="Collapsed" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16,20,8">
                <TextBlock Text="Lệnh gọi agent" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="CommandBox" AutomationProperties.Name="Lệnh gọi agent"
                         ToolTip="CLI agent chạy không tương tác, nhận prompt qua stdin. Mặc định: claude -p" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,14"
                           Text="Toolbox gọi CLI này ở thư mục workspace và chỉ đọc kết quả. Không lệnh nào được thêm khi bạn chưa duyệt." />

                <StackPanel x:Name="RunningPanel" Visibility="Collapsed">
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,8" />
                    <TextBlock x:Name="RunningText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
                </StackPanel>

                <TextBox x:Name="ErrorBox" IsReadOnly="True" TextWrapping="Wrap" Visibility="Collapsed"
                         Foreground="{DynamicResource Danger}" AutomationProperties.Name="Lỗi" />

                <StackPanel x:Name="ResultPanel" Visibility="Collapsed">
                    <TextBlock Text="Agent đề xuất" Style="{StaticResource FieldLabel}" />
                    <ItemsControl x:Name="ItemList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked}" Margin="0,4" Checked="OnItemToggled" Unchecked="OnItemToggled">
                                    <StackPanel>
                                        <TextBlock Foreground="{DynamicResource Ink}" FontWeight="SemiBold" Text="{Binding Label}" />
                                        <TextBlock Foreground="{DynamicResource Ink}" FontFamily="Consolas" Text="{Binding CommandLine}" TextWrapping="Wrap" />
                                        <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Text="{Binding Reason}" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</v:SheetBase>
