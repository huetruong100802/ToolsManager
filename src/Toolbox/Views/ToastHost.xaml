<UserControl x:Class="Toolbox.Views.ToastHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,18"
             AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="Thông báo">
    <ItemsControl x:Name="List" Focusable="False" MaxWidth="460">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border x:Name="Card" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource InputLine}" BorderThickness="1"
                        CornerRadius="10" Padding="14,10,8,10" Margin="0,8,0,0" MinWidth="280">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.22" Color="#000000" />
                    </Border.Effect>
                    <DockPanel>
                        <TextBlock x:Name="Glyph" DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE946;" FontSize="16"
                                   Foreground="{DynamicResource Accent}" Margin="0,2,10,0" VerticalAlignment="Top" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="&#xE711;" FontFamily="{StaticResource IconFont}"
                                FontSize="11" Width="26" Height="26" MinHeight="26" Padding="0" Margin="6,0,0,0" VerticalAlignment="Top"
                                BorderThickness="0" Background="Transparent" Click="OnClose" Tag="{Binding}"
                                AutomationProperties.Name="Đóng thông báo" ToolTip="Đóng" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="{Binding ActionText}" Click="OnAction" Tag="{Binding}"
                                Visibility="{Binding ActionVisibility}" Padding="12,3" MinHeight="26" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Extra}" Margin="0,8,0,0" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource GhostButton}" Content="{Binding Text}" Click="OnExtra" Tag="{Binding}" Padding="12,3" MinHeight="26" Margin="0,0,8,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="Success">
                        <Setter TargetName="Card" Property="Background" Value="{DynamicResource OkSoft}" />
                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource OkLine}" />
                        <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Ok}" />
                        <Setter TargetName="Glyph" Property="Text" Value="&#xE73E;" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Error">
                        <Setter TargetName="Card" Property="Background" Value="{DynamicResource DangerSoft}" />
                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource DangerLine}" />
                        <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Danger}" />
                        <Setter TargetName="Glyph" Property="Text" Value="&#xE783;" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
