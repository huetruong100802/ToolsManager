<UserControl x:Class="Toolbox.Views.CommandPalette"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" Focusable="False">
    <!-- Lớp phủ: bấm ra ngoài để đóng. -->
    <Grid Background="{DynamicResource Scrim}" MouseLeftButtonDown="OnScrimClick">
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,70,0,0" Width="580" MaxHeight="480"
                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource InputLine}" BorderThickness="1" CornerRadius="12"
                MouseLeftButtonDown="OnCardClick">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.35" Color="#000000" />
            </Border.Effect>
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="14,12,14,8">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Foreground="{DynamicResource Faint}" Margin="2,0,0,0" />
                    <TextBox x:Name="Input" Margin="26,0,0,0" BorderThickness="0" Background="Transparent" FontSize="15"
                             PreviewKeyDown="OnInputKeyDown" TextChanged="OnTextChanged"
                             AutomationProperties.Name="Tìm hoặc chạy" />
                    <TextBlock x:Name="Hint" Text="Gõ tên profile, workflow, tool, workspace hoặc hành động…" IsHitTestVisible="False"
                               Foreground="{DynamicResource Faint}" FontSize="15" Margin="31,0,0,0" VerticalAlignment="Center" />
                </Grid>
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="14,7">
                    <TextBlock Foreground="{DynamicResource Faint}" FontSize="11"
                               Text="Enter: chạy hoặc mở   ·   Ctrl+Enter: mở nơi chứa   ·   ↑ ↓: chọn   ·   Esc: đóng" />
                </Border>
                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                    <Grid>
                        <ListBox x:Name="Results" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="OnResultDoubleClick"
                                 AutomationProperties.Name="Kết quả">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Padding="14,8" Background="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" CornerRadius="9" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                Background="{DynamicResource TagBg}">
                                            <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="{DynamicResource TagInk}" />
                                        </Border>
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{DynamicResource Accent}"
                                                   Width="24" Margin="0,0,10,0" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Entry.Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Entry.Subtitle}" FontSize="11" Foreground="{DynamicResource Muted}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="NoResults" Text="Không tìm thấy gì khớp." Foreground="{DynamicResource Muted}" HorizontalAlignment="Center"
                                   Margin="0,26" Visibility="Collapsed" />
                    </Grid>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
