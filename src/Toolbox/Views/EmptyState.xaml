<UserControl x:Class="Toolbox.Views.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
        <Border Width="64" Height="64" CornerRadius="16" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Center" Margin="0,0,0,14">
            <TextBlock x:Name="GlyphText" Style="{StaticResource Icon}" FontSize="28" Foreground="{DynamicResource Accent}"
                       HorizontalAlignment="Center" />
        </Border>
        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,6" />
        <TextBlock x:Name="BodyText" Foreground="{DynamicResource Muted}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="20" />
        <StackPanel x:Name="Actions" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0" />
    </StackPanel>
</UserControl>
