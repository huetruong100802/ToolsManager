<Window x:Class="Toolbox.ShareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chia sẻ" Width="560" SizeToContent="Height" MaxHeight="620" ResizeMode="NoResize"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Huỷ" IsCancel="True" MinWidth="90" Margin="0,0,8,0" />
                <Button Content="Chia sẻ…" IsDefault="True" Click="OnShare" MinWidth="110" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </Border>
        <StackPanel Margin="20,16,20,14">
            <TextBlock x:Name="HeaderText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,10"
                       Text="Đây là thứ sẽ có trong file .toolbox. Không có đường dẫn tuyệt đối của máy bạn, tác vụ hay log." />
            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="Lines" TextWrapping="Wrap" FontSize="12.5" LineHeight="20" />
            </ScrollViewer>
            <Border x:Name="WarningBox" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1"
                    CornerRadius="8" Padding="12,8" Margin="0,12,0,0" Visibility="Collapsed">
                <TextBlock x:Name="Warnings" TextWrapping="Wrap" Foreground="{DynamicResource WarnInk}" FontSize="12.5" />
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
