<Window x:Class="Toolbox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Toolbox" Width="980" Height="620" MinWidth="820" MinHeight="400"
        Style="{StaticResource AppWindow}" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1" Padding="20,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Click="OnConnectAgent" Margin="0,0,6,0"
                            AutomationProperties.Name="Kết nối agent…">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE71B;" Margin="0,0,7,0" />
                            <TextBlock Text="Kết nối agent…" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Click="OnDeskMcp" Margin="0,0,6,0"
                            AutomationProperties.Name="desk-mcp…" Content="desk-mcp…" />
                    <Button Click="OnImport" Margin="0,0,8,0" AutomationProperties.Name="Nhập gói…">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Margin="0,0,7,0" />
                            <TextBlock Text="Nhập gói…" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnPickApp" Margin="0,0,8,0" AutomationProperties.Name="App đã cài…"
                            ToolTip="Chọn từ các app có trong Start Menu">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE71D;" Margin="0,0,7,0" />
                            <TextBlock Text="App đã cài…" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Click="OnAdd" AutomationProperties.Name="+ Thêm tool">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,7,0" />
                            <TextBlock Text="Thêm tool" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource Accent}" Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE90F;" FontSize="17" Foreground="White"
                                   HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Toolbox" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Quản lý tool trên máy, đóng gói gửi đồng đội" Foreground="{StaticResource Muted}" FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="20,10">
            <DockPanel>
                <Button x:Name="PackButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Đóng gói"
                        Click="OnPack" IsEnabled="False" />
                <Button x:Name="RemoveButton" DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="Xoá khỏi danh sách"
                        Click="OnRemove" IsEnabled="False" Margin="0,0,8,0" />
                <CheckBox x:Name="SelectAll" DockPanel.Dock="Left" Content="Chọn tất cả" VerticalAlignment="Center" Margin="0,0,16,0"
                          Click="OnSelectAll" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <DockPanel Margin="20,14,20,0">
            <Border x:Name="InstallBanner" DockPanel.Dock="Top" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentSoftLine}"
                    BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Cài vào máy" Click="OnInstall" Margin="12,0,0,0" />
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{StaticResource Accent}"
                               FontSize="16" Margin="0,0,10,0" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="Toolbox chưa được cài. Cài để có shortcut trong Start Menu và double-click file .toolbox là nhập gói (không cần quyền admin)." />
                </DockPanel>
            </Border>

            <!-- Tìm + lọc tag -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <ComboBox x:Name="TagFilter" DockPanel.Dock="Right" Width="170" Margin="10,0,0,0" SelectionChanged="OnFilterChanged"
                          ToolTip="Lọc theo tag" />
                <Grid>
                    <TextBox x:Name="SearchBox" Padding="32,6,8,6" TextChanged="OnFilterChanged"
                             AutomationProperties.Name="Tìm" />
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Foreground="{StaticResource Faint}"
                               HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False" />
                    <TextBlock Text="Tìm theo tên, mô tả, tag…" Foreground="{StaticResource Faint}" Margin="34,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>

            <Grid>
                <ListBox x:Name="ToolList" HorizontalContentAlignment="Stretch" MouseDoubleClick="OnListDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Grid Grid.Column="1" Width="38" Height="38" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Border CornerRadius="8" Background="{StaticResource AccentSoft}">
                                        <Grid>
                                            <TextBlock Text="{Binding Initial}" Visibility="{Binding InitialVisibility}" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{Binding Icon}" Visibility="{Binding IconVisibility}" Width="26" Height="26"
                                                   RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" Stroke="White" StrokeThickness="2"
                                             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4"
                                             ToolTip="{Binding StatusTip}" />
                                </Grid>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Tool.Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <ItemsControl ItemsSource="{Binding Tool.Tags}" ItemTemplate="{StaticResource TagChip}" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Tool.Description}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0" />
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding WarningVisibility}" Margin="0,3,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="TextElement.Foreground" Value="{StaticResource Danger}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanInstall}" Value="True">
                                                        <Setter Property="TextElement.Foreground" Value="{StaticResource WarnInk}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="12" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Warning}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Button Style="{StaticResource GhostButton}" Click="OnOpenFolder" Tag="{Binding}" ToolTip="Mở thư mục"
                                            AutomationProperties.Name="Thư mục" Width="34" Padding="0">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" />
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" Click="OnEdit" Tag="{Binding}" ToolTip="Sửa"
                                            AutomationProperties.Name="Sửa" Width="34" Padding="0" Margin="2,0,8,0">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" />
                                    </Button>
                                    <Button Style="{StaticResource PrimaryButton}" Click="OnInstallSetup" Tag="{Binding}" Padding="12,4"
                                            Visibility="{Binding InstallVisibility}" AutomationProperties.Name="Cài đặt">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="12" Margin="0,0,6,0" />
                                            <TextBlock Text="Cài đặt" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OnRun" Tag="{Binding}" AutomationProperties.Name="▶ Chạy" Padding="12,4"
                                            Visibility="{Binding RunVisibility}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="12" Foreground="{StaticResource Accent}"
                                                       Margin="0,0,6,0" />
                                            <TextBlock Text="Chạy" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource AccentSoft}" HorizontalAlignment="Center"
                            Margin="0,0,0,14">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE90F;" FontSize="28" Foreground="{StaticResource Accent}"
                                   HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Chưa có tool nào" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock Foreground="{StaticResource Muted}" TextAlignment="Center" LineHeight="20">
                        Bấm "App đã cài…" để chọn app trên máy, "Thêm tool" để chọn file,<LineBreak />
                        hoặc kéo thả file .exe / script / shortcut / thư mục vào đây.<LineBreak />
                        Kéo thả (hoặc double-click) file .toolbox để nhập gói.
                    </TextBlock>
                </StackPanel>
            </Grid>
        </DockPanel>
    </DockPanel>
</Window>
