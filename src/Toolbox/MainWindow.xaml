<Window x:Class="Toolbox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Toolbox.Views"
        Title="Toolbox" Width="1180" Height="680" MinWidth="1000" MinHeight="460"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Thanh trạng thái: số tác vụ đang chạy và cổng đang dùng. -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="14,4">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="OnStatusTasksClick"
                        Content="Xem tác vụ" Padding="10,2" AutomationProperties.Name="Mở trang Tác vụ" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Rail trái: Thư viện, Tổng quan, Tác vụ, danh sách workspace. -->
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12,14,12,12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,16">
                        <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource BrandGradient}" Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE90F;" FontSize="16" Foreground="White" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Toolbox" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <Button x:Name="AddWorkspaceButton" DockPanel.Dock="Bottom" Click="OnAddWorkspace" Margin="0,8,0,0"
                            AutomationProperties.Name="Thêm workspace">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,7,0" />
                            <TextBlock Text="Thêm workspace" />
                        </StackPanel>
                    </Button>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <RadioButton x:Name="LibraryNav" Style="{StaticResource RailItem}" Click="OnLibraryClick" IsChecked="True"
                                         AutomationProperties.Name="Thư viện">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" Foreground="{StaticResource Accent}" Margin="0,0,10,0" />
                                    <TextBlock Text="Thư viện" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="OverviewNav" Style="{StaticResource RailItem}" Click="OnOverviewClick"
                                         AutomationProperties.Name="Tổng quan">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" Foreground="{StaticResource Accent}" Margin="0,0,10,0" />
                                    <TextBlock Text="Tổng quan" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="TasksNav" Style="{StaticResource RailItem}" Click="OnTasksClick"
                                         AutomationProperties.Name="Tác vụ">
                                <DockPanel>
                                    <Border x:Name="TasksBadge" DockPanel.Dock="Right" Visibility="Collapsed" Background="{StaticResource OkSoft}"
                                            BorderBrush="{StaticResource OkLine}" BorderThickness="1" CornerRadius="9" Padding="6,0"
                                            Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="Số tác vụ đang chạy ngầm">
                                        <TextBlock x:Name="TasksBadgeCount" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Ok}" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" Foreground="{StaticResource Accent}" Margin="0,0,10,0" />
                                        <TextBlock Text="Tác vụ" />
                                    </StackPanel>
                                </DockPanel>
                            </RadioButton>

                            <TextBlock Text="WORKSPACE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Faint}"
                                       Margin="10,18,0,6" />
                            <ItemsControl x:Name="WorkspaceList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Style="{StaticResource RailItem}" Click="OnWorkspaceClick" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                     ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Name}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Visibility="{Binding RunningVisibility}" Background="{StaticResource OkSoft}"
                                                        BorderBrush="{StaticResource OkLine}" BorderThickness="1" CornerRadius="9" Padding="6,0"
                                                        Margin="6,0,0,0" VerticalAlignment="Center"
                                                        ToolTip="Số tác vụ đang chạy ngầm">
                                                    <TextBlock Text="{Binding RunningCount}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Ok}" />
                                                </Border>
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="12"
                                                           Foreground="{StaticResource WarnInk}" Visibility="{Binding MissingVisibility}"
                                                           Margin="6,0,0,0" ToolTip="Không tìm thấy thư mục" />
                                                <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{Binding ColorBrush}" Margin="0,0,10,0"
                                                         VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoWorkspaceHint" Style="{StaticResource Hint}" Margin="10,2,6,0"
                                       Text="Chưa có workspace. Thêm một thư mục repo để chạy lệnh ngay tại đó." />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Vùng nội dung: thư viện, tổng quan, tác vụ, hoặc trang của workspace đang chọn. -->
            <Grid Grid.Column="1">
                <views:LibraryView x:Name="Library" />
                <views:OverviewView x:Name="OverviewPage" Visibility="Collapsed" />
                <views:TasksView x:Name="TasksPage" Visibility="Collapsed" />

                <DockPanel x:Name="WorkspacePage" Visibility="Collapsed">
                    <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                            BorderThickness="0,0,0,1" Padding="20,14">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource GhostButton}" Click="OnOpenWorkspaceFolder" Margin="0,0,6,0"
                                        AutomationProperties.Name="Mở thư mục workspace">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Margin="0,0,7,0" />
                                        <TextBlock Text="Mở thư mục" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource DangerButton}" Click="OnRemoveWorkspace" Content="Gỡ workspace"
                                        ToolTip="Chỉ gỡ khỏi Toolbox, không xoá thư mục trên đĩa" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="WsDot" Width="12" Height="12" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="WsName" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock x:Name="WsPath" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           Margin="22,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border x:Name="MissingBanner" DockPanel.Dock="Top" Background="{StaticResource WarnSoft}"
                            BorderBrush="{StaticResource WarnLine}" BorderThickness="0,0,0,1" Padding="20,10" Visibility="Collapsed">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Trỏ lại thư mục…" Click="OnRelocateWorkspace" Margin="12,0,0,0" />
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource WarnInk}"
                                       FontSize="16" Margin="0,0,10,0" />
                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource WarnInk}"
                                       Text="Không tìm thấy thư mục của workspace này (đã đổi tên, di chuyển hoặc xoá). Lệnh không chạy được cho tới khi trỏ lại." />
                        </DockPanel>
                    </Border>

                    <views:WorkspaceView x:Name="WorkspaceContent" />
                </DockPanel>

                <!-- Panel log trượt bên phải, đè lên nội dung. -->
                <views:InspectorView x:Name="Inspector" HorizontalAlignment="Right" VerticalAlignment="Stretch" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
