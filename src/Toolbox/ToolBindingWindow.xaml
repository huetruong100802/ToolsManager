<Window x:Class="Toolbox.ToolBindingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sửa tool trong workspace" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Huỷ" IsCancel="True" MinWidth="90" Margin="0,0,8,0" />
                <Button x:Name="OkButton" Content="Lưu" IsDefault="True" Click="OnOk" MinWidth="90"
                        Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </Border>

        <StackPanel Margin="20,18,20,8">
            <TextBlock x:Name="ToolNameText" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="Chỉ áp dụng cho workspace này. Muốn đổi lệnh, đường dẫn hay mô tả của tool, dùng nút Tool… ở trang tool."
                       Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,14" />

            <TextBlock Text="Thư mục chạy" Style="{StaticResource FieldLabel}" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Chọn thư mục…" Click="OnBrowse" Margin="8,0,0,0" />
                <TextBox x:Name="CwdBox" TextChanged="OnCwdChanged" AutomationProperties.Name="Thư mục chạy"
                         ToolTip="Tương đối so với thư mục workspace; để trống thì dùng thư mục mặc định của tool" />
            </DockPanel>
            <TextBlock x:Name="CwdHint" Style="{StaticResource Hint}" Margin="0,4,0,14" TextWrapping="Wrap" />

            <TextBlock Text="Tham số riêng của workspace" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="ArgsBox" AutomationProperties.Name="Tham số riêng của workspace" />
            <TextBlock x:Name="ArgsHint" Style="{StaticResource Hint}" Margin="0,4,0,14" TextWrapping="Wrap" />
        </StackPanel>
    </DockPanel>
</Window>
