<Window x:Class="Toolbox.AgentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kết nối agent (MCP)" Width="760" Height="620" MinHeight="420"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <!-- Một dòng: tên + đường dẫn, chip trạng thái, nút Kết nối / Huỷ kết nối. -->
        <DataTemplate x:Key="TargetRow">
            <Grid ToolTip="{Binding ToolTip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
                <Border x:Name="Chip" Grid.Column="1" CornerRadius="9" Padding="8,1" Margin="12,0" VerticalAlignment="Center"
                        Background="{StaticResource Hover}">
                    <TextBlock x:Name="ChipText" Text="Chưa kết nối" FontSize="11" Foreground="{StaticResource Muted}" />
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ConnectButton" Content="Kết nối" Click="OnConnect" MinWidth="104" Style="{StaticResource PrimaryButton}" />
                    <Button x:Name="DisconnectButton" Content="Huỷ kết nối" Click="OnDisconnect" MinWidth="104" Margin="6,0,0,0"
                            Style="{StaticResource DangerButton}" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Link}" Value="Connected">
                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentSoft}" />
                    <Setter TargetName="ChipText" Property="Text" Value="Đã kết nối" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource Accent}" />
                    <Setter TargetName="ConnectButton" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="DisconnectButton" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Link}" Value="Stale">
                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource WarnSoft}" />
                    <Setter TargetName="ChipText" Property="Text" Value="Trỏ tới exe khác" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource WarnInk}" />
                    <Setter TargetName="ConnectButton" Property="Content" Value="Kết nối lại" />
                    <Setter TargetName="DisconnectButton" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Đóng" IsCancel="True" MinWidth="90" />
                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                           Text="Phiên Claude Code đang mở cần mở lại để nhận thay đổi. Claude vẫn hỏi bạn trước mỗi lần chạy tool." />
            </DockPanel>
        </Border>

        <DockPanel Margin="20,16,20,16">
            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{StaticResource Muted}" LineHeight="19"
                       Text="Claude Code dùng Toolbox để tìm (list_tools) và chạy (run_tool) các tool trong danh sách. Kết nối toàn máy, hoặc chỉ cho từng workspace." />

            <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                <ContentControl x:Name="UserRow" ContentTemplate="{StaticResource TargetRow}" Focusable="False" />
            </Border>

            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Click="OnPickWorkspace" Margin="8,0,0,0" AutomationProperties.Name="Thư mục khác…">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Margin="0,0,7,0" />
                        <TextBlock Text="Thư mục khác…" />
                    </StackPanel>
                </Button>
                <TextBox x:Name="FilterBox" DockPanel.Dock="Right" Width="220" TextChanged="OnFilterChanged" ToolTip="Lọc workspace theo đường dẫn"
                         AutomationProperties.Name="Lọc workspace" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Workspace Claude Code" FontWeight="SemiBold" />
                    <TextBlock x:Name="UserHint" Style="{StaticResource Hint}" Margin="0,2,0,0" Visibility="Collapsed"
                               Text="Đã kết nối toàn máy, mọi workspace đều dùng được." />
                </StackPanel>
            </DockPanel>

            <Expander DockPanel.Dock="Bottom" Header="Client khác (Claude Desktop, Cursor, VS Code): khai báo tay" Margin="0,12,0,0">
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="Claude Desktop / Cursor (mcpServers)" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Copy" Click="OnCopy" Tag="{Binding ElementName=DesktopConfig}"
                                VerticalAlignment="Top" Margin="8,0,0,0" />
                        <TextBox x:Name="DesktopConfig" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap"
                                 HorizontalScrollBarVisibility="Auto" Background="#F3F4F6" />
                    </DockPanel>
                    <TextBlock Text="VS Code / GitHub Copilot (.vscode/mcp.json hoặc mcp.json của user)" Style="{StaticResource FieldLabel}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Copy" Click="OnCopy" Tag="{Binding ElementName=VsCodeConfig}"
                                VerticalAlignment="Top" Margin="8,0,0,0" />
                        <TextBox x:Name="VsCodeConfig" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap"
                                 HorizontalScrollBarVisibility="Auto" Background="#F3F4F6" />
                    </DockPanel>
                </StackPanel>
            </Expander>

            <Grid>
                <ListBox x:Name="WorkspaceList" ItemTemplate="{StaticResource TargetRow}" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                <TextBlock x:Name="EmptyText" Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed"
                           Text="Chưa có workspace nào. Workspace hiện ở đây sau khi bạn mở Claude Code trong thư mục đó, hoặc bấm &quot;Thư mục khác…&quot;." />
            </Grid>
        </DockPanel>
    </DockPanel>
</Window>
