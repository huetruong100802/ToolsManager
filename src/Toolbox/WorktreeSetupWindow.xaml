<Window x:Class="Toolbox.WorktreeSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Worktree" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Huỷ" IsCancel="True" MinWidth="90" Margin="0,0,8,0" />
                <Button Content="Lưu cấu hình" IsDefault="True" Click="OnSave" MinWidth="120"
                        Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </Border>

        <StackPanel Margin="20,18,20,8">
            <TextBlock Text="File local đưa vào worktree" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="FilesBox" AcceptsReturn="True" Height="100" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" AutomationProperties.Name="File local đưa vào worktree" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,14" TextWrapping="Wrap"
                       Text="Mỗi dòng một đường dẫn tương đối với workspace, ví dụ pnpm-lock.yaml. File chưa theo git được copy; file theo git đã sửa thì áp diff so với HEAD. Không ghi đè file đã khác." />

            <TextBlock Text="Lệnh cài đặt trong worktree" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="CommandBox" AutomationProperties.Name="Lệnh cài đặt trong worktree" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,18" TextWrapping="Wrap"
                       Text="Ví dụ: pnpm install --frozen-lockfile. Để trống nếu không cần." />

            <Separator Margin="0,0,0,14" />

            <TextBlock Text="Chuẩn bị một worktree" Style="{StaticResource FieldLabel}" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Chọn thư mục…" Click="OnBrowse" Margin="8,0,0,0" />
                <TextBox x:Name="PathBox" TextChanged="OnPathChanged" AutomationProperties.Name="Thư mục worktree"
                         ToolTip="Thư mục worktree đã tạo bằng git worktree add" />
            </DockPanel>
            <DockPanel Margin="0,10,0,0">
                <Button x:Name="PrepareButton" DockPanel.Dock="Right" Content="Chuẩn bị" Click="OnPrepare"
                        MinWidth="110" Style="{StaticResource PrimaryButton}" IsEnabled="False" />
                <CheckBox x:Name="InstallBox" Content="Chạy lệnh cài đặt sau khi chuẩn bị" IsChecked="True"
                          VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock x:Name="ReportText" TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>
    </DockPanel>
</Window>
