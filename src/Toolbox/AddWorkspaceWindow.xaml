<Window x:Class="Toolbox.AddWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm workspace" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Huỷ" IsCancel="True" MinWidth="90" Margin="0,0,8,0" />
                <Button x:Name="AddButton" Content="Thêm" IsDefault="True" Click="OnAdd" MinWidth="90"
                        Style="{StaticResource PrimaryButton}" IsEnabled="False" />
            </StackPanel>
        </Border>

        <StackPanel Margin="20,18,20,8">
            <TextBlock Text="Thư mục workspace *" Style="{StaticResource FieldLabel}" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Chọn thư mục…" Click="OnBrowse" Margin="8,0,0,0" />
                <TextBox x:Name="PathBox" TextChanged="OnPathChanged" AutomationProperties.Name="Thư mục workspace"
                         ToolTip="Thư mục gốc của repo hoặc dự án" />
            </DockPanel>
            <TextBlock x:Name="PathHint" Style="{StaticResource Hint}" Margin="0,4,0,14"
                       Text="Toolbox đọc thư mục này để đoán dự án dùng .NET, Git, Angular hay npm." />

            <TextBlock Text="Tên *" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="NameBox" TextChanged="OnNameChanged" AutomationProperties.Name="Tên workspace" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,14" Text="Tên hiện trên rail bên trái. Mặc định là tên thư mục." />

            <TextBlock Text="Tool nhận diện được" Style="{StaticResource FieldLabel}" />
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8"
                    Padding="12,8" MinHeight="60">
                <Grid>
                    <ItemsControl x:Name="DetectionList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked}" Margin="0,4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Reason}" Foreground="{StaticResource Muted}" FontSize="12"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoDetection" Foreground="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center"
                               Text="Chọn thư mục để Toolbox dò tool." />
                </Grid>
            </Border>
            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,14"
                       Text="Bỏ chọn tool không muốn gắn. Có thể thêm hoặc bớt tool sau ở trang workspace." />
        </StackPanel>
    </DockPanel>
</Window>
