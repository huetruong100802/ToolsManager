<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Bảng màu sáng: nền xanh-xám rất nhạt, card trắng, viền mảnh, accent indigo.
         Tokens.Dark.xaml phải có đúng cùng bộ khoá; Core/Theme.cs chép màu từ file này sang bộ brush đang dùng. -->
    <SolidColorBrush x:Key="WindowBg" Color="#F4F6FB" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Line" Color="#E4E8F0" />
    <SolidColorBrush x:Key="InputLine" Color="#D3D9E4" />
    <SolidColorBrush x:Key="InputLineHover" Color="#AEB8C8" />
    <SolidColorBrush x:Key="Ink" Color="#141B2D" />
    <SolidColorBrush x:Key="Muted" Color="#5D6880" />
    <SolidColorBrush x:Key="Faint" Color="#626A7D" />
    <SolidColorBrush x:Key="Hover" Color="#F1F4FA" />
    <SolidColorBrush x:Key="Pressed" Color="#E5EAF3" />
    <SolidColorBrush x:Key="Accent" Color="#4F46E5" />
    <SolidColorBrush x:Key="AccentHover" Color="#4338CA" />
    <SolidColorBrush x:Key="AccentPressed" Color="#3730A3" />
    <SolidColorBrush x:Key="AccentSoft" Color="#EEF2FF" />
    <SolidColorBrush x:Key="AccentSoftLine" Color="#C7D2FE" />
    <SolidColorBrush x:Key="TagBg" Color="#F1F5F9" />
    <SolidColorBrush x:Key="TagInk" Color="#475569" />
    <SolidColorBrush x:Key="Ok" Color="#15803D" />
    <SolidColorBrush x:Key="OkSoft" Color="#EAF7EF" />
    <SolidColorBrush x:Key="OkLine" Color="#BDE5CC" />
    <SolidColorBrush x:Key="Danger" Color="#B91C1C" />
    <SolidColorBrush x:Key="DangerSoft" Color="#FEF2F2" />
    <SolidColorBrush x:Key="WarnSoft" Color="#FFF7ED" />
    <SolidColorBrush x:Key="WarnLine" Color="#FDBA74" />
    <SolidColorBrush x:Key="WarnInk" Color="#9A3412" />
        <!-- Mới ở v2: màu chữ trên nền accent, nền accent đặc (nút chính), viền nút nguy hiểm, nền mã, thanh cuộn. -->
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentFill" Color="#4F46E5" />
    <SolidColorBrush x:Key="AccentFillHover" Color="#4338CA" />
    <SolidColorBrush x:Key="AccentFillPressed" Color="#3730A3" />
    <SolidColorBrush x:Key="DangerLine" Color="#F5C2C2" />
    <SolidColorBrush x:Key="CodeBg" Color="#F3F4F6" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#CDD3DE" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#A7B0C0" />
    <SolidColorBrush x:Key="ItemHover" Color="#FBFCFF" />
    <SolidColorBrush x:Key="ItemSelected" Color="#F7F8FF" />
</ResourceDictionary>
