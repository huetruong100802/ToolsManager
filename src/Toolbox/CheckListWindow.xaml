<Window x:Class="Toolbox.CheckListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Toolbox.Views"
        Title="Chọn" Width="540" Height="460" MinWidth="420" MinHeight="300"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="20,16,20,16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
            <TextBlock x:Name="HintText" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <v:SearchField x:Name="Search" DockPanel.Dock="Top" Placeholder="Tìm…" Margin="0,0,0,8" />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Huỷ" IsCancel="True" MinWidth="90" Margin="8,0,0,0" />
            <Button x:Name="OkButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" MinWidth="110" IsDefault="True" Click="OnOk" />
        </DockPanel>

        <TextBlock x:Name="EmptyText" Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed" />

        <ListBox x:Name="ItemList" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEnabled}" Margin="2,6" VerticalContentAlignment="Center">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource Ink}" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
