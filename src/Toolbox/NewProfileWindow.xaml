<Window x:Class="Toolbox.NewProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Toolbox.Views"
        Title="Profile mới" Width="560" Height="520" MinHeight="460"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="Huỷ" IsCancel="True" MinWidth="80" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BackButton" Content="Quay lại" Click="OnBack" MinWidth="90" Margin="0,0,8,0" />
                    <Button x:Name="NextButton" Content="Tiếp" Click="OnNext" MinWidth="90" Style="{StaticResource PrimaryButton}" />
                    <Button x:Name="SaveButton" Content="Lưu" Click="OnSave" MinWidth="90" Margin="0,0,8,0" Visibility="Collapsed" />
                    <Button x:Name="SaveRunButton" Content="Lưu và chạy" Click="OnSaveRun" MinWidth="110"
                            Style="{StaticResource PrimaryButton}" Visibility="Collapsed" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top" Margin="20,16,20,0">
            <TextBlock x:Name="StepTitle" FontSize="15" FontWeight="SemiBold" />
            <TextBlock x:Name="StepHint" Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Margin="20,12,20,12">
            <!-- Bước 1: tool -->
            <DockPanel x:Name="ToolPanel" Margin="0,0,0,34">
                <v:SearchField x:Name="ToolSearch" DockPanel.Dock="Top" Placeholder="Tìm tool…" Margin="0,0,0,8" />
                <ListBox x:Name="ToolList" DisplayMemberPath="Display" SelectionChanged="OnToolChanged"
                         AutomationProperties.Name="Chọn tool" />
            </DockPanel>
            <Button x:Name="CustomToolLink" Content="Không có trong danh sách? + Tool riêng…" Click="OnCustomTool"
                    Style="{StaticResource GhostButton}" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    ToolTip="Tạo lệnh riêng trong workspace này, rồi quay lại tạo profile cho nó." />

            <!-- Bước 2: lệnh -->
            <StackPanel x:Name="CommandPanel" Visibility="Collapsed">
                <TextBlock Text="Lệnh" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="ActionBox" DisplayMemberPath="Label" SelectionChanged="OnActionChanged"
                          AutomationProperties.Name="Lệnh" />
                <StackPanel x:Name="VariantPanel">
                    <TextBlock Text="Biến thể" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
                    <ComboBox x:Name="VariantBox" DisplayMemberPath="Label" SelectionChanged="OnVariantChanged"
                              AutomationProperties.Name="Biến thể" />
                </StackPanel>
                <TextBlock x:Name="FixedCommandNote" Style="{StaticResource Hint}" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>

            <!-- Bước 3: thông số -->
            <ScrollViewer x:Name="ParamsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl x:Name="ParamList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Prompt}" Style="{StaticResource FieldLabel}" />
                                    <!-- Nút ▾ chỉ hiện khi tham số có nguồn gợi ý (catalog khai báo); ô vẫn gõ tay được. -->
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Width="32" Click="OnPickOptions"
                                                Visibility="{Binding OptionsVisibility}"
                                                ToolTip="Chọn từ danh sách gợi ý" AutomationProperties.Name="{Binding Prompt, StringFormat='Chọn gợi ý cho {0}'}">
                                            <Path Data="M 0,0 L 8,0 L 4,5 Z" Fill="{StaticResource Muted}" Width="8" Height="5" Stretch="Fill" />
                                        </Button>
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="{Binding Prompt}" ToolTip="{Binding Default}" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" FontSize="12"
                                               Visibility="{Binding ErrorVisibility}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel x:Name="PairPanel" Margin="0,0,0,10">
                        <TextBlock x:Name="PairLabel" Text="Tham số" Style="{StaticResource FieldLabel}" />
                        <v:PairEditor x:Name="Pairs" Changed="OnPairsChanged" />
                    </StackPanel>

                    <TextBlock Text="Lệnh sẽ chạy" Style="{StaticResource FieldLabel}" Margin="0,4,0,0" />
                    <Border Background="{StaticResource WindowBg}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="8" Padding="10,8">
                        <TextBlock x:Name="PreviewText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                   AutomationProperties.Name="Lệnh sẽ chạy" />
                    </Border>

                    <TextBlock Text="Tên profile *" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
                    <TextBox x:Name="NameBox" TextChanged="OnNameChanged" AutomationProperties.Name="Tên profile" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
