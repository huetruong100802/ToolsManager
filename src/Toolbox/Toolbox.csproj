<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Toolbox</RootNamespace>
    <AssemblyName>Toolbox</AssemblyName>
    <!-- Icon của exe, cửa sổ, shortcut Start Menu và file .toolbox. Vẽ lại bằng tools/make-icon.ps1. -->
    <ApplicationIcon>Assets\toolbox.ico</ApplicationIcon>
    <!-- Phiên bản hiện trong app và trong "Installed apps" của Windows. Bản phát hành lấy từ tag (xem .github/workflows/release.yml). -->
    <Version>1.1.0</Version>
    <Product>Toolbox</Product>
    <Description>Quản lý, chạy, đóng gói tool và cho AI agent dùng qua MCP</Description>
    <Company>Toolbox</Company>
    <Copyright>MIT License</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Chỉ dùng assembly có sẵn trong .NET Framework 4.8 để giữ một file Toolbox.exe duy nhất. -->
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Security" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Toolbox.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mặc định của danh mục tool; lần đầu chạy được chép ra %APPDATA%\Toolbox\catalog.json để sửa. -->
    <EmbeddedResource Include="Core\Workspaces\catalog.default.json" LogicalName="catalog.default.json" />
  </ItemGroup>

</Project>
