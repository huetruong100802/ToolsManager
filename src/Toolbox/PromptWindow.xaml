<Window x:Class="Toolbox.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhập tên" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Huỷ" IsCancel="True" MinWidth="90" Margin="0,0,8,0" />
                <Button x:Name="OkButton" Content="Lưu" IsDefault="True" Click="OnOk" MinWidth="90"
                        Style="{StaticResource PrimaryButton}" IsEnabled="False" />
            </StackPanel>
        </Border>

        <StackPanel Margin="20,18,20,12">
            <TextBlock x:Name="Prompt" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="ValueBox" TextChanged="OnValueChanged" />
            <TextBlock x:Name="Note" Style="{StaticResource Hint}" Margin="0,4,0,0" Visibility="Collapsed" />
        </StackPanel>
    </DockPanel>
</Window>
