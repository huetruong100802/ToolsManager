<Window x:Class="Toolbox.PairsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Toolbox.Views"
        Title="Tham số của profile" Width="560" Height="420" MinHeight="300"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Huỷ" IsCancel="True" MinWidth="90" Margin="0,0,8,0" />
                <Button x:Name="OkButton" Content="Lưu" IsDefault="True" Click="OnOk" MinWidth="90" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16,20,12">
                <TextBlock x:Name="Heading" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="Note" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,12" />
                <v:PairEditor x:Name="Editor" Changed="OnChanged" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
