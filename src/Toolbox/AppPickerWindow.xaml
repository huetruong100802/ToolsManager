<Window x:Class="Toolbox.AppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm từ app đã cài" Width="640" Height="580" MinHeight="360" MinWidth="460"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Huỷ" IsCancel="True" MinWidth="90" Margin="0,0,8,0" />
                <Button x:Name="AddButton" Content="Thêm" IsDefault="True" Click="OnAdd" MinWidth="90" IsEnabled="False"
                        Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </Border>

        <DockPanel Margin="20,16,20,12">
            <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Danh sách lấy từ Start Menu. Chọn một app rồi bấm Thêm (hoặc double-click) — đường dẫn, tên, tham số được điền sẵn." />

            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBox x:Name="SearchBox" Padding="32,6,8,6" TextChanged="OnSearchChanged" AutomationProperties.Name="Tìm app" />
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Foreground="{StaticResource Faint}"
                           HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False" />
                <TextBlock Text="Tìm app…" Foreground="{StaticResource Faint}" Margin="34,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Grid>
                <ListBox x:Name="AppList" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnListDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Margin" Value="0,0,0,4" />
                            <Setter Property="Padding" Value="10,7" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,12,0" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Info.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Info.TargetPath}" Foreground="{StaticResource Muted}" FontSize="12"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="2" Background="{StaticResource Hover}" CornerRadius="9" Padding="8,1" Margin="10,0,0,0"
                                        VerticalAlignment="Center" Visibility="{Binding AddedVisibility}">
                                    <TextBlock Text="Đã có" FontSize="11" Foreground="{StaticResource Muted}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="StatusText" Text="Đang đọc Start Menu…" Foreground="{StaticResource Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
        </DockPanel>
    </DockPanel>
</Window>
